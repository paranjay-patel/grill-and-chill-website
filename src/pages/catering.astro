---
import Layout from '../layouts/Layout.astro';
import { RESTAURANT, RESTAURANT_PHONE_LINK, RESTAURANT_WHATSAPP_LINK } from '../data/site-config';
import cateringPackages from '../data/catering.json';

const tiers = cateringPackages.filter(p => !p.isFixedPrice);
const starterPackage = cateringPackages.find(p => p.isFixedPrice);
---

<Layout title="Bespoke Catering for Small Gatherings in Surat | Grill & Chill" activeTab="catering" description="Exquisite Punjabi & Authentic Chinese catering packages crafted for intimate house parties and special small events in Surat. Min 20 plates.">
  <!-- Hero Section -->
  <section class="relative w-full py-32 md:py-44 flex items-center justify-center overflow-hidden px-6 bg-gradient-to-b from-[#180001] via-surface to-surface-container-low">
    <div class="absolute inset-0 z-0">
      <img alt="Exquisite catering food buffet setup" class="w-full h-full object-cover scale-105 opacity-55 filter brightness-75" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCBFSl4IY2C77Jcsm-SYi8d-ZCOnXfu19wUSCEJ1c6_VHbMcQon8afgGbYwjxmVANmbQqKSPITdZ6qbga0uwL-RB8lxGkLHzIf52vGB33qM65Zmdu8dkeo2BrzJ32dm9EEkETUgaiTzVfbccpwl_-Gws0uAQmWhMKaJUVs8-Z64F6PVHZofrR2yh81nIQoNxB6YelKjS8JPa1lqSqkWesk8ZcJry9MCVWeTS-Kk80UyCtU9oUCsBPo-XbV46dYc1hPf8fDmffIQSMM"/>
      <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/65 to-transparent"></div>
    </div>
    
    <div class="relative z-10 max-w-5xl w-full text-center space-y-8 mt-8">
      <div class="inline-block px-5 py-2 rounded-full border border-primary/20 bg-surface-container-low/80 backdrop-blur-md">
        <span class="text-[#ffe16d] font-label text-xs tracking-[0.25em] uppercase font-bold">Bespoke Catering Services</span>
      </div>
      <h1 class="text-4xl sm:text-6xl md:text-8xl font-black font-headline text-white leading-none tracking-tighter uppercase">
        Catering for Small <br class="hidden md:inline"/><span class="text-primary italic font-normal">Gatherings</span> in Surat
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-on-surface-variant max-w-3xl mx-auto font-body leading-relaxed">
        Exquisite Punjabi &amp; Authentic Chinese delicacies crafted for intimate house parties and special small events. Experience the heritage of taste at your doorstep.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-6 max-w-md mx-auto">
        <a class="w-full sm:w-auto bg-[#ffe16d] text-black hover:bg-[#ffe16d]/90 px-8 py-4 rounded-full font-label font-bold text-lg flex items-center justify-center gap-2 shadow-xl shadow-[#ffe16d]/10 hover:scale-105 transition-all btn-magnetic"
          href={RESTAURANT_PHONE_LINK}>
          <span class="material-symbols-outlined">call</span> Call Now
        </a>
        <a class="w-full sm:w-auto bg-green-600 text-white hover:bg-green-700 px-8 py-4 rounded-full font-label font-bold text-lg flex items-center justify-center gap-2 shadow-xl shadow-green-900/40 hover:scale-105 transition-all btn-magnetic"
          href={RESTAURANT_WHATSAPP_LINK} target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined">chat</span> WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Intro / Trust Banner -->
  <section class="bg-[#180506]/40 py-20 border-y border-white/10 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,179,172,0.03)_0%,transparent_70%)]"></div>
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
      <span class="material-symbols-outlined text-primary/30 text-5xl mb-6">format_quote</span>
      <h2 class="text-3xl font-headline font-bold text-[#ffe16d] mb-6 uppercase tracking-wider">Taste of Tradition, Service You Can Trust</h2>
      <p class="text-lg sm:text-xl text-[#dac1bf] leading-relaxed font-body">
        At Grill &amp; Chill, we specialize in making small celebrations grand. Whether it's a cozy family gathering or a lively office lunch, our team provides reliable and affordable catering solutions without compromising on the authentic flavors of Punjabi and Chinese cuisines. We handle the food, so you can focus on the memories.
      </p>
    </div>
  </section>

  <!-- Perfect For (Single Row Grid with Glass Spotlight Cards) -->
  <section class="py-24 px-6 md:px-12 bg-surface-container-low relative overflow-hidden">
    <div class="absolute inset-0 opacity-5 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <span class="text-primary font-label font-bold tracking-[0.4em] uppercase text-xs mb-4 block">Tailored Experiences</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-headline font-black text-white uppercase tracking-tight">Perfect For</h2>
        <div class="w-24 h-1 bg-[#ffe16d]/30 mx-auto mt-6"></div>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <!-- Birthday Parties -->
        <div class="group relative h-80 overflow-hidden rounded-2xl border border-white/10 glass-card-spotlight transition-all duration-500 shadow-2xl hover:-translate-y-2">
          <img alt="Beautiful birthday dinner candle table setup" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-65 group-hover:opacity-85" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBVdFNKLAgYt0qKL68fiyU_elbiN3EDE1qo7mNUyoYlVBEek8SPlc3j_FFd10bYN2StWFXDnt_lnrsSqzlqBlxlwcN2hutdF0lsQ7i1uGmY6OBFm8JET0lzU8v6e6F-zlJMY89Fq6T4sNayn6BC3Vt3yKMxsCJ35YjV05uIc8LWnqv_PW3EHfX-OEvdrM13uFy7EOU_NYxi7uDlUEjnyPnfyCqmcLiGBCLzra4I1JqXxyy_lCBqJoz3ujvEys9djlniXnpO84aYZeY"/>
          <div class="absolute inset-0 bg-gradient-to-t from-[#310002] via-[#310002]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6 w-full z-10">
            <span class="text-[10px] text-primary font-label tracking-widest uppercase mb-1 block font-bold">Intimate &amp; Joyful</span>
            <h3 class="text-lg sm:text-xl font-headline font-black text-white uppercase leading-tight">Birthday Celebrations</h3>
          </div>
          <div class="absolute top-0 right-0 p-4 z-10">
            <div class="w-9 h-9 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center text-primary group-hover:bg-[#ffe16d] group-hover:text-black transition-colors duration-300">
              <span class="material-symbols-outlined text-lg">cake</span>
            </div>
          </div>
        </div>

        <!-- House Gatherings -->
        <div class="group relative h-80 overflow-hidden rounded-2xl border border-white/10 glass-card-spotlight transition-all duration-500 shadow-2xl hover:-translate-y-2">
          <img alt="Friends gathering at house sharing delicious food" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-65 group-hover:opacity-85" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDE5BU-wyUZPy5U4eOOq7GzweMeiQyh0YA39JGYPxNbqYHGGXT1DPxG-6VJKnuWd5tqAic3Wez7y0RWo3kfOjpNpUaU71IPSVRKQqqFBtK-0W-nmZmi1AUUrrgsut9bgMgb3GjEjRZ2egjyeunSJV-TpS4-653puuJ_CIe2mmBvsfXZHcoEWDmuVD4q7082W3OMJucAKDmy3A5zZK8Ikc9R4AaJEup0M_UP0-CbRoboBdKW7L57b3YrEXe1ZGahDAvi4JWQm4e9uBI"/>
          <div class="absolute inset-0 bg-gradient-to-t from-[#310002] via-[#310002]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6 w-full z-10">
            <span class="text-[10px] text-primary font-label tracking-widest uppercase mb-1 block font-bold">Warm &amp; Casual</span>
            <h3 class="text-lg sm:text-xl font-headline font-black text-white uppercase leading-tight">House Parties</h3>
          </div>
          <div class="absolute top-0 right-0 p-4 z-10">
            <div class="w-9 h-9 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center text-primary group-hover:bg-[#ffe16d] group-hover:text-black transition-colors duration-300">
              <span class="material-symbols-outlined text-lg">home</span>
            </div>
          </div>
        </div>

        <!-- Small Functions -->
        <div class="group relative h-80 overflow-hidden rounded-2xl border border-white/10 glass-card-spotlight transition-all duration-500 shadow-2xl hover:-translate-y-2">
          <img alt="Elegant table settings for boutique event function" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-65 group-hover:opacity-85" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCBFSl4IY2C77Jcsm-SYi8d-ZCOnXfu19wUSCEJ1c6_VHbMcQon8afgGbYwjxmVANmbQqKSPITdZ6qbga0uwL-RB8lxGkLHzIf52vGB33qM65Zmdu8dkeo2BrzJ32dm9EEkETUgaiTzVfbccpwl_-Gws0uAQmWhMKaJUVs8-Z64F6PVHZofrR2yh81nIQoNxB6YelKjS8JPa1lqSqkWesk8ZcJry9MCVWeTS-Kk80UyCtU9oUCsBPo-XbV46dYc1hPf8fDmffIQSMM"/>
          <div class="absolute inset-0 bg-gradient-to-t from-[#310002] via-[#310002]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6 w-full z-10">
            <span class="text-[10px] text-primary font-label tracking-widest uppercase mb-1 block font-bold">Refined &amp; Elegant</span>
            <h3 class="text-lg sm:text-xl font-headline font-black text-white uppercase leading-tight">Small Functions</h3>
          </div>
          <div class="absolute top-0 right-0 p-4 z-10">
            <div class="w-9 h-9 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center text-primary group-hover:bg-[#ffe16d] group-hover:text-black transition-colors duration-300">
              <span class="material-symbols-outlined text-lg">celebration</span>
            </div>
          </div>
        </div>

        <!-- Office Lunches -->
        <div class="group relative h-80 overflow-hidden rounded-2xl border border-white/10 glass-card-spotlight transition-all duration-500 shadow-2xl hover:-translate-y-2">
          <img alt="Corporate office team eating lunch together" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-65 group-hover:opacity-85" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBmZVdrjB88JRta62H9snahyBy-OsgUHCcvp-t3cjKwyrYX8pLp8QSrLimB2igjkCfdeLaxnIzUOoGpr_h8p5fOzbApvspksaYubO3bm2XciUanKkeSR2JIjbU_AlARwvQpTYj_RTavNx50LSlHqzY72Cn-pgwaXFgUZ8HM6iXL4GVz7jHm8mU4VZE8QlPdxYCT9iA-8nc1-m_UVFIcvRyxhBThLDcLSg_2GX3YzF7l7N3JtqntOMDXh2uVF7OaQyecJF_RkusfePU"/>
          <div class="absolute inset-0 bg-gradient-to-t from-[#310002] via-[#310002]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6 w-full z-10">
            <span class="text-[10px] text-primary font-label tracking-widest uppercase mb-1 block font-bold">Punctual &amp; Professional</span>
            <h3 class="text-lg sm:text-xl font-headline font-black text-white uppercase leading-tight">Office Meets</h3>
          </div>
          <div class="absolute top-0 right-0 p-4 z-10">
            <div class="w-9 h-9 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center text-primary group-hover:bg-[#ffe16d] group-hover:text-black transition-colors duration-300">
              <span class="material-symbols-outlined text-lg">work</span>
            </div>
          </div>
        </div>

        <!-- Family Meets -->
        <div class="group relative h-80 overflow-hidden rounded-2xl border border-white/10 glass-card-spotlight transition-all duration-500 shadow-2xl hover:-translate-y-2">
          <img alt="Multigenerational family sharing classic Indian dishes" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-65 group-hover:opacity-85" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBw5WxEJVIcFeQnwlI9xGnialqSoMt4-FkaMYb-kftnNARo-7bKJzYzqaJRXK7ZCw0LfhpOnlA_Dk-h3HQ37aOan0B0s-2EEmmpxV49Dj548CzZ7ccBGz5aah2Rm44cgfu0UqwTmrj-hJUEjjZPo4GMAFZgsD5Os7RGv4yy7suJJX-QKZXmkVynSKtjHnqg-p89_wqAM4ngPxcIjdhEslz6NMog6fPhwVtD4PNq9CxfXMkeJxtEWIQ2RMnJDHtxnFr5N7iOZxp3Ebs"/>
          <div class="absolute inset-0 bg-gradient-to-t from-[#310002] via-[#310002]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6 w-full z-10">
            <span class="text-[10px] text-primary font-label tracking-widest uppercase mb-1 block font-bold">Traditional Heritage</span>
            <h3 class="text-lg sm:text-xl font-headline font-black text-white uppercase leading-tight">Family Meets</h3>
          </div>
          <div class="absolute top-0 right-0 p-4 z-10">
            <div class="w-9 h-9 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center text-primary group-hover:bg-[#ffe16d] group-hover:text-black transition-colors duration-300">
              <span class="material-symbols-outlined text-lg">groups</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Menu Highlights (Structured Dark Theme Panels) -->
  <section class="py-24 px-6 md:px-12 bg-gradient-to-b from-surface-container-low to-surface">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-primary font-label font-bold tracking-[0.4em] uppercase text-xs mb-4 block">Flavor Profiles</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-headline font-black text-white uppercase tracking-tight">Our Catering Specialties</h2>
        <div class="w-24 h-1 bg-[#ffe16d]/30 mx-auto mt-6"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Punjabi Menu -->
        <div class="relative overflow-hidden group rounded-3xl glass-card-spotlight border border-white/10 shadow-2xl transition-all duration-300">
          <div class="h-64 overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent z-10"></div>
            <img alt="Rich traditional Punjabi food layout" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBSjtLIRjLw3HwZEW1G4r2adr0U5b5iebAvoL5vWMTQeQyO7CVe1qJ22301UT9WT9tm-C6dMXTpcFqW-kU7WXuHeSGmfWlIoQGRULBFvINkcoSIdHiv3je6inNOaQPnHoHjgVr52-G8MQ8CfoZqo0xnXlf4Rv2TenrX47FlpkBhdgVNA31wLhOS3j7A10D3a1UlCEm2EpXhAmdSwCmw8qOiEvjfW5hPXtH9fppfPg8G8Iqw4HBzx8nwRQiWkMUzYvmuWGaaSzTVkqE"/>
          </div>
          <div class="p-8 md:p-10 relative z-20">
            <h3 class="text-3xl font-headline font-black text-[#ffe16d] mb-6 uppercase tracking-tighter">Punjabi Cuisine</h3>
            <ul class="space-y-4 text-[#dac1bf] font-body mb-8">
              <li class="flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-lg">star</span>
                <span>Rich Paneer specialties cooked in home-style masalas</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-lg">star</span>
                <span>Authentic slow-cooked Dal Makhani &amp; Dal Tadka</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-lg">star</span>
                <span>Soft, hot assorted tandoori breads baked fresh</span>
              </li>
            </ul>
            <a href="/menu#punjabi" class="block w-full py-4 text-center rounded-full border border-primary/20 text-primary font-bold font-label hover:bg-[#ffe16d] hover:text-black hover:border-transparent transition-all btn-magnetic">
              Explore Full Menu
            </a>
          </div>
        </div>

        <!-- Chinese Menu -->
        <div class="relative overflow-hidden group rounded-3xl glass-card-spotlight border border-white/10 shadow-2xl transition-all duration-300">
          <div class="h-64 overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent z-10"></div>
            <img alt="Hot authentic Chinese fried rice and noodles" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBd7F3F65i649kAhLUsTCNf5HbgAQQeIVoRPaIu-OriGd7yMvqonfk8kZENeCd9CrGhBeo84MXiXuYlaSNymQRnBu8e9xzZVTcCMtkALn0TEmgkOkWHAhDwOpJLZtKC09l-XVS3ogLs0peylZKSvrLX4X3G5BmQHRImsEiORysbTxI-cSe5R8cDE1xJsffnOJxWveiu7G2O5556krUoDJpShnjW4HnnoI_YlVfjNDPOHdSHV2v-k3KaRyKO6o-Bol8Lu_6go3Pc2LU"/>
          </div>
          <div class="p-8 md:p-10 relative z-20">
            <h3 class="text-3xl font-headline font-black text-[#ffe16d] mb-6 uppercase tracking-tighter">Chinese Culinary</h3>
            <ul class="space-y-4 text-[#dac1bf] font-body mb-8">
              <li class="flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-lg">star</span>
                <span>Signature Veg Manchurian (dry &amp; gravy options)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-lg">star</span>
                <span>Stir-fried Hakka &amp; Schezwan Noodles</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-lg">star</span>
                <span>Crispy, honey-glazed Chili Potatoes and starters</span>
              </li>
            </ul>
            <a href="/menu#chinese" class="block w-full py-4 text-center rounded-full border border-primary/20 text-primary font-bold font-label hover:bg-[#ffe16d] hover:text-black hover:border-transparent transition-all btn-magnetic">
              Explore Full Menu
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customization & Service Scale (Unified Details Section) -->
  <section class="py-24 px-6 md:px-12 bg-surface">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8">
      <!-- Fully Customizable Panel -->
      <div class="group glass-card-spotlight p-10 md:p-12 rounded-3xl border border-white/10 shadow-2xl relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-12 -right-12 w-32 h-32 bg-primary/10 rounded-full blur-[80px] group-hover:bg-primary/20 transition-all"></div>
        <div class="w-12 h-12 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center text-primary mb-6 group-hover:bg-[#ffe16d] group-hover:text-black transition-all">
          <span class="material-symbols-outlined">edit_note</span>
        </div>
        <h3 class="text-4xl font-headline font-black text-[#ffe16d] mb-6 uppercase tracking-tighter">Fully Customizable</h3>
        <p class="text-lg text-[#dac1bf] leading-relaxed font-body">
          Tailor every single starter, main course, and dessert to match your exact budget, guest list, and spice preferences. We believe your party should reflect your unique culinary style.
        </p>
      </div>

      <!-- Service Scale Panel -->
      <div class="glass-card-spotlight p-10 md:p-12 rounded-3xl border border-white/10 shadow-2xl relative overflow-hidden transition-all duration-300">
        <h3 class="text-4xl font-headline font-black text-[#ffe16d] mb-10 uppercase tracking-tighter">Service Scale</h3>
        <div class="space-y-8">
          <div class="flex items-center gap-6 group">
            <div class="w-16 h-16 bg-[#310002]/90 border border-primary/20 rounded-xl flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-black transition-all duration-300">
              <span class="material-symbols-outlined text-2xl">person_add</span>
            </div>
            <div>
              <p class="text-xs font-label uppercase tracking-[0.3em] text-[#dac1bf]/60 mb-1">Minimum Guests</p>
              <p class="text-3xl font-headline font-black text-white leading-none">20 – 30 <span class="text-sm font-normal text-primary">PERSONS</span></p>
            </div>
          </div>
          <div class="flex items-center gap-6 group">
            <div class="w-16 h-16 bg-[#310002]/90 border border-primary/20 rounded-xl flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-black transition-all duration-300">
              <span class="material-symbols-outlined text-2xl">group</span>
            </div>
            <div>
              <p class="text-xs font-label uppercase tracking-[0.3em] text-[#dac1bf]/60 mb-1">Maximum Guests</p>
              <p class="text-3xl font-headline font-black text-white leading-none">80 – 100 <span class="text-sm font-normal text-primary">PERSONS</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Packages (Cohesive 3-Column Layout) -->
  <section class="py-24 px-6 md:px-12 bg-gradient-to-b from-surface to-surface-container-low">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-primary font-label font-bold tracking-[0.4em] uppercase text-xs mb-4 block">Event Packages</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-headline font-black text-white uppercase tracking-tight">Pricing Packages</h2>
        <p class="text-lg text-[#dac1bf] font-body mt-2">Affordable luxury tailored for small events in Surat</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {tiers.map(pkg => (
          <div class={`group p-8 md:p-10 rounded-3xl flex flex-col justify-between transition-all duration-300 relative glass-card-spotlight ${
            pkg.isPopular 
              ? 'border-2 border-[#ffe16d] shadow-[0_20px_50px_rgba(255,225,109,0.05)] scale-105 z-10' 
              : 'border border-white/10 hover:border-primary/20 shadow-xl'
          }`}>
            {pkg.isPopular && (
              <div class="absolute -top-5 left-1/2 -translate-x-1/2 bg-[#ffe16d] text-black text-[10px] font-black px-6 py-2 rounded-full uppercase tracking-[0.3em] shadow-xl z-20">
                MOST POPULAR
              </div>
            )}
            <div>
              <div class="mb-8">
                <span class="text-xs font-label font-bold text-primary tracking-[0.3em] uppercase block mb-2">{pkg.badge}</span>
                <h3 class="text-3xl font-headline font-black text-white uppercase tracking-tighter">{pkg.name}</h3>
              </div>
              <div class="mb-8">
                <span class="text-5xl font-headline font-black text-[#ffe16d] leading-none">{pkg.price}</span>
                <span class="text-xs font-label uppercase tracking-widest text-[#dac1bf]/60 block mt-2">{pkg.subtitle}</span>
              </div>
              <ul class="space-y-4 mb-12 text-[#dac1bf] font-body">
                {pkg.features.map(feature => (
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary text-lg">check_circle</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
            {pkg.isPopular ? (
              <a href={RESTAURANT_PHONE_LINK} class="w-full py-4 text-center rounded-full bg-[#ffe16d] text-black font-bold font-label shadow-xl hover:bg-[#ffe16d]/90 transition-all btn-magnetic">
                Book {pkg.name}
              </a>
            ) : (
              <a href={RESTAURANT_PHONE_LINK} class="w-full py-4 text-center rounded-full border border-primary/20 text-primary font-bold font-label hover:bg-primary hover:text-black hover:border-transparent transition-all shadow-lg btn-magnetic">
                Select {pkg.name}
              </a>
            )}
          </div>
        ))}
      </div>

      <div class="mt-16 text-center p-6 glass-card-spotlight border border-white/10 rounded-full max-w-3xl mx-auto">
        <p class="text-primary font-bold font-headline uppercase text-sm tracking-wider">
          🎉 Special customized options and discounts available for gatherings above 50 plates!
        </p>
      </div>
    </div>
  </section>

  <!-- Sample Package & Delivery Areas -->
  <section class="py-24 px-6 md:px-12 bg-surface">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      {starterPackage && (
        <div class="group glass-card-spotlight p-10 md:p-12 rounded-3xl border border-white/10 hover:border-primary/20 shadow-2xl relative overflow-hidden transition-all duration-300">
          <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-primary/5 rounded-full blur-[100px] opacity-10"></div>
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-primary text-3xl">restaurant_menu</span>
            <h3 class="text-3xl font-headline font-black text-white uppercase tracking-tighter">{starterPackage.name}</h3>
          </div>
          <div class="flex items-baseline gap-3 mb-8">
            <span class="text-5xl font-headline font-black text-[#ffe16d] font-label">{starterPackage.price}</span>
            <span class="text-sm font-label uppercase tracking-widest text-[#dac1bf]/60">{starterPackage.badge}</span>
          </div>
          <p class="text-lg text-[#dac1bf] mb-10 leading-relaxed font-body">{starterPackage.description}</p>
          <a href="/menu" class="inline-flex items-center gap-2 text-primary hover:text-[#ffe16d] font-bold font-label transition-all uppercase tracking-widest text-sm btn-magnetic">
            View Detailed Menu <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
      )}
      
      <div class="space-y-8">
        <h3 class="text-4xl font-headline font-black text-white uppercase tracking-wider">We Deliver To</h3>
        <div class="flex flex-wrap gap-3">
          {["Piplod", "Vesu", "Adajan", "Dumas", "Magdalla", "Pal", "Katargam"].map(area => (
            <span class="px-6 py-3 glass-card-spotlight border border-white/10 hover:border-primary/20 transition-all rounded-full text-white font-label uppercase text-xs tracking-widest font-semibold shadow-inner">
              {area}
            </span>
          ))}
        </div>
        <div class="pt-4">
          <p class="flex items-center gap-3 text-[#dac1bf] font-body text-lg">
            <span class="material-symbols-outlined text-[#ffe16d]">location_on</span>
            Providing gourmet hot catering services across major hubs in Surat.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Mini-Section -->
  <section class="py-24 px-6 md:px-12 bg-gradient-to-b from-surface to-surface-container-low border-t border-white/10">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl font-headline font-black text-center text-white mb-16 uppercase tracking-wider">Why Choose Us</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { icon: 'restaurant', title: 'Freshly Prepared', desc: 'Made with hand-picked premium ingredients just hours before your event.' },
          { icon: 'payments', title: 'Affordable', desc: 'Exquisite catering options crafted to fit perfectly inside your budget.' },
          { icon: 'edit_calendar', title: 'Custom Flex', desc: 'Highly flexible menu choices tailored to your specific guests.' },
          { icon: 'verified_user', title: 'Reliable Delivery', desc: 'Professional team coordination and guaranteed on-time delivery.' }
        ].map(item => (
          <div class="group glass-card-spotlight p-8 rounded-2xl text-center border border-white/10 hover:border-primary/20 transition-all duration-300 shadow-lg">
            <div class="w-16 h-16 bg-[#310002]/90 border border-primary/20 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-[#ffe16d] group-hover:text-black transition-colors duration-300 text-primary">
              <span class="material-symbols-outlined text-3xl">{item.icon}</span>
            </div>
            <h4 class="font-headline font-black text-[#ffe16d] uppercase tracking-tight mb-3 text-lg">{item.title}</h4>
            <p class="text-sm text-[#dac1bf]/80 leading-relaxed font-body">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact & Map Section -->
  <section class="py-24 px-6 md:px-12 bg-surface overflow-hidden relative">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-5xl font-headline font-black text-white mb-8 leading-tight uppercase tracking-tighter">Ready to host your next party?</h2>
          <div class="space-y-6 mb-12">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 glass-card-spotlight border border-white/10 rounded-full flex items-center justify-center text-primary">
                <span class="material-symbols-outlined">call</span>
              </div>
              <span class="text-2xl font-headline font-bold text-white">{RESTAURANT.displayPhone}</span>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 glass-card-spotlight border border-white/10 rounded-full flex items-center justify-center text-primary">
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <span class="text-xl text-[#dac1bf] font-body">{RESTAURANT.address}</span>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a class="bg-[#ffe16d] text-black px-8 py-4 rounded-full font-label font-bold text-lg text-center hover:scale-105 transition-all duration-300 btn-magnetic"
              href={RESTAURANT_PHONE_LINK}>
              Call Now
            </a>
            <a class="bg-green-600 text-white px-8 py-4 rounded-full font-label font-bold text-lg flex items-center justify-center gap-2 shadow-xl shadow-green-900/40 hover:scale-105 transition-all duration-300 btn-magnetic"
              href={RESTAURANT_WHATSAPP_LINK} target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined">chat</span> WhatsApp
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden h-[400px] shadow-2xl border border-white/10 hover:border-primary/20 transition-all duration-300">
          <iframe class="w-full h-full filter brightness-75 hover:brightness-100 transition-all duration-500"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d29769.244220211112!2d72.72121617431641!3d21.146208!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be0527f87e48501%3A0xcce1104d05e07735!2sGrill%20%26%20Chill!5e0!3m2!1sen!2sin!4v1775391580654!5m2!1sen!2sin"
            style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>
