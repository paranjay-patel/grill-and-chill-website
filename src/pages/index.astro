---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { RESTAURANT, RESTAURANT_PHONE_LINK } from '../data/site-config';
import heroImage from '../assets/herosection.png';
---

<Layout title="Grill & Chill | Best Punjabi Restaurant & Tandoor in Surat" activeTab="home">
  <!-- Hero Section -->
  <section class="relative flex items-center px-6 md:px-12 overflow-hidden h-[90vh] min-h-[80vh]">
    <div class="absolute inset-0 z-0">
      <Image alt="High-end grill restaurant interior with warm lighting" class="w-full h-full object-cover opacity-100 mix-blend-luminosity object-center" src={heroImage} />
      <div class="absolute inset-0 bg-gradient-to-b from-background/95 via-background/70 to-background/50 md:bg-gradient-to-r md:from-background/95 md:via-background/50 md:to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-4xl py-12">
      <span class="inline-block px-4 py-1 mb-4 border border-outline-variant text-secondary-fixed font-label text-xs tracking-[0.3em] uppercase rounded-full">
        Best Restaurant &amp; Tandoor in Surat — Est. 2019
      </span>
      <h1 class="font-headline text-4xl sm:text-6xl md:text-8xl text-on-surface leading-[0.9] tracking-tighter mb-6 uppercase italic">
        The Art of <br />
        <span class="text-primary text-glow">Fire &amp; Spice</span>
      </h1>
      <p class="font-body text-lg md:text-xl text-on-surface-variant max-w-xl mb-10 leading-relaxed">
        A curated journey through heritage recipes, where the flame meets the finest ingredients in a dance of smoky perfection.
      </p>
      <div class="flex flex-wrap gap-6">
        <a href="/menu" class="bg-primary text-on-primary px-10 py-4 rounded-lg font-headline tracking-widest uppercase hover:bg-primary-fixed transition-colors text-center inline-block">
          EXPLORE THE MENU
        </a>
      </div>
    </div>
  </section>

  <!-- Culinary Categories -->
  <section class="cuisine-section py-24 md:py-28 px-6 md:px-12">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-16 md:mb-20">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-secondary-fixed/20 bg-surface-container-high/70 text-secondary-fixed font-label text-xs tracking-[0.35em] uppercase">
          Signature selections
        </span>
        <h2 class="font-headline text-4xl md:text-6xl text-secondary-fixed uppercase mt-6">Cuisines</h2>
        <div class="editorial-line w-24 mx-auto my-6"></div>
        <p class="font-body text-on-surface-variant max-w-2xl mx-auto text-lg md:text-xl leading-relaxed">
          A more refined way to explore the menu, with each cuisine presented like a signature dish. Rich, layered, and designed to feel as inviting as the food itself.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
        <!-- Punjabi Cuisine Card -->
        <article class="cuisine-card group">
          <div class="cuisine-card-media">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCDn2K4rueHS-LK2dE7WbhNI1bpURfsXyY4T9bwc_Osw4-Q1YTYu6ZKDZhFqOTWdsMn387S-1JNwPFdmKnmoauWdyye1whNmhtDtL2jzlYenlpar-UmCKBlai4TldrWOQEkEo-gwBoIzPdnl86i2wWc5GbOpQCZI2YOKmO-rc4wQ0kH0pn-I3Kp-5HF_icc7cr87PlUPmIPG9tpzTUT-6xy2y5AxcB6WLXQ99s2BjW7CTtLMfEh76s_8xa_zJYtOCuPqwPHhPYMqI8" alt="Punjabi cuisine" loading="lazy" class="cuisine-card-image"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
            <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-primary/20 to-transparent"></div>
            <div class="absolute top-5 left-5 flex items-center gap-3">
              <span class="cuisine-badge">01</span>
              <span class="cuisine-chip">Heritage</span>
            </div>
            <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4">
              <div>
                <p class="text-[0.72rem] uppercase tracking-[0.35em] text-secondary-fixed/90 font-label mb-2">Smoky indulgence</p>
                <h3 class="font-headline text-3xl md:text-4xl text-white uppercase leading-none">Punjabi</h3>
              </div>
              <div class="text-right">
                <p class="text-[0.68rem] uppercase tracking-[0.3em] text-white/70 font-label">Signature</p>
                <p class="text-sm text-white/90 font-body mt-1">Paneer Angara</p>
              </div>
            </div>
          </div>
          <div class="p-7 md:p-8">
            <p class="font-body text-on-surface-variant leading-relaxed">
              Hearty tandoori dishes, rich curries, and freshly baked breads brought together with a deep, comforting spice profile.
            </p>
            <div class="flex flex-wrap gap-2 mt-6 mb-7">
              <span class="cuisine-tag">Tandoori</span>
              <span class="cuisine-tag">Fresh breads</span>
              <span class="cuisine-tag">Bold gravies</span>
            </div>
            <a href="/menu#punjabi" class="cuisine-link">
              Explore menu
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </article>

        <!-- Chinese Cuisine Card -->
        <article class="cuisine-card group">
          <div class="cuisine-card-media">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuB4sDMmFxe_CA2sUcgbymzArzMIGLlsKmCaUgyeVnTieKYB4-_qNlbJrSL2kNY8re-6oOrfuyzeQ5fYg7GNxD7MdgU0NBDQq1LCCHjlcEMNwiPe5U-BvpIN314HdD7jwCLkgmgZCgzkvuvAtF-PoBfqfjfTFq88tXp9-GbZDvPsS7WtMlHkvwUX5GZvt5DqcdQQ-BeWyjD4p9C1BYii-pn_GS41HD_5VqcnRyLGuvGAYem0Xt-Rz8VBlaVVPSegOpo2B346sN7fHQM" alt="Chinese cuisine" loading="lazy" class="cuisine-card-image"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
            <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-secondary-fixed/15 to-transparent"></div>
            <div class="absolute top-5 left-5 flex items-center gap-3">
              <span class="cuisine-badge">02</span>
              <span class="cuisine-chip">Wok-fired</span>
            </div>
            <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4">
              <div>
                <p class="text-[0.72rem] uppercase tracking-[0.35em] text-secondary-fixed/90 font-label mb-2">Fast, fresh, fragrant</p>
                <h3 class="font-headline text-3xl md:text-4xl text-white uppercase leading-none">Chinese</h3>
              </div>
              <div class="text-right">
                <p class="text-[0.68rem] uppercase tracking-[0.3em] text-white/70 font-label">Signature</p>
                <p class="text-sm text-white/90 font-body mt-1">Manchurian</p>
              </div>
            </div>
          </div>
          <div class="p-7 md:p-8">
            <p class="font-body text-on-surface-variant leading-relaxed">
              Crisp vegetables, bold sauces, and wok-fresh stir fries with the kind of balance that keeps every bite lively and memorable.
            </p>
            <div class="flex flex-wrap gap-2 mt-6 mb-7">
              <span class="cuisine-tag">Stir fry</span>
              <span class="cuisine-tag">Dim sum</span>
              <span class="cuisine-tag">Saucy classics</span>
            </div>
            <a href="/menu#chinese" class="cuisine-link">
              Explore menu
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </article>

        <!-- Chicken Specials Card -->
        <article class="cuisine-card group">
          <div class="cuisine-card-media">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAtkNeHyzWfjXzxFIPimqDlXzo7a4t0cST2-mCq7NOdW76wGrnvFoqh6wyI0hYZSbvC8sPHK4K41_z7PUz1wMg-wgLgqgzeja0vR6n1kaf2YVzbMevYxki2YPe8qGNWhFQ0gK065zYqukSVNCTZtuL3rbFXv_a0tN-BZu8YlXjdzSpYV15_GK7biGV9vCBM0hLBGTLQe6QURbl3YEml6UJVijnF9XjPqCyCNw9jxcpDBKDYimuY0BJnlryI81AR0mYrPY38k_pV9Wk" alt="Chicken cuisine" loading="lazy" class="cuisine-card-image"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
            <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-tertiary-fixed/15 to-transparent"></div>
            <div class="absolute top-5 left-5 flex items-center gap-3">
              <span class="cuisine-badge">03</span>
              <span class="cuisine-chip">Chef special</span>
            </div>
            <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4">
              <div>
                <p class="text-[0.72rem] uppercase tracking-[0.35em] text-secondary-fixed/90 font-label mb-2">Grilled comfort</p>
                <h3 class="font-headline text-3xl md:text-4xl text-white uppercase leading-none">Chicken</h3>
              </div>
              <div class="text-right">
                <p class="text-[0.68rem] uppercase tracking-[0.3em] text-white/70 font-label">Signature</p>
                <p class="text-sm text-white/90 font-body mt-1">Chicken Biryani</p>
              </div>
            </div>
          </div>
          <div class="p-7 md:p-8">
            <p class="font-body text-on-surface-variant leading-relaxed">
              Char-grilled chicken dishes with balanced marinades, slow-cooked depth, and modern plating that feels elevated without losing warmth.
            </p>
            <div class="flex flex-wrap gap-2 mt-6 mb-7">
              <span class="cuisine-tag">Grilled</span>
              <span class="cuisine-tag">Marinated</span>
              <span class="cuisine-tag">Comfort food</span>
            </div>
            <a href="/menu#chicken" class="cuisine-link">
              Explore menu
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </article>
      </div>

      <div class="mt-14 text-center">
        <a href="/menu" class="inline-flex items-center gap-3 px-10 md:px-14 py-4 rounded-full bg-secondary-fixed text-on-secondary-fixed font-bold tracking-widest uppercase shadow-lg shadow-black/15 hover:bg-secondary-container hover:shadow-black/20 transition-all">
          View Full Menu
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-32 px-6 md:px-12 bg-surface border-y border-outline-variant/10">
    <div class="max-w-7xl mx-auto">
      <div class="mb-20 text-center">
        <span class="text-primary font-label tracking-[0.4em] uppercase text-xs mb-4 block">Our Commitment</span>
        <h2 class="font-headline text-4xl md:text-6xl text-secondary-fixed uppercase">WHY CHOOSE US</h2>
        <div class="w-24 h-1 bg-primary mx-auto mt-6 opacity-30"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Point 1 -->
        <div class="bg-surface-container-high p-8 rounded-xl border border-outline-variant/10 hover:border-secondary-fixed/40 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-full bg-surface-container-highest flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl">restaurant</span>
          </div>
          <h3 class="font-headline text-on-surface uppercase text-lg mb-4 tracking-wider">Freshly Cooked, Not Pre-made</h3>
          <p class="font-body text-on-surface-variant text-sm leading-relaxed">
            Every dish is prepared from scratch when you order, ensuring the highest quality and taste.
          </p>
        </div>
        <!-- Point 2 -->
        <div class="bg-surface-container-high p-8 rounded-xl border border-outline-variant/10 hover:border-secondary-fixed/40 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-full bg-surface-container-highest flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl">set_meal</span>
          </div>
          <h3 class="font-headline text-on-surface uppercase text-lg mb-4 tracking-wider">Affordable Combos &amp; Thalis</h3>
          <p class="font-body text-on-surface-variant text-sm leading-relaxed">
            Experience a full range of flavors with our thoughtfully curated and budget-friendly meal sets.
          </p>
        </div>
        <!-- Point 3 -->
        <div class="bg-surface-container-high p-8 rounded-xl border border-outline-variant/10 hover:border-secondary-fixed/40 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-full bg-surface-container-highest flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl">speed</span>
          </div>
          <h3 class="font-headline text-on-surface uppercase text-lg mb-4 tracking-wider">Quick Service &amp; Takeaway Friendly</h3>
          <p class="font-body text-on-surface-variant text-sm leading-relaxed">
            Whether you're dining in or on the go, we ensure your food is ready fast without compromising on quality.
          </p>
        </div>
        <!-- Point 4 -->
        <div class="bg-surface-container-high p-8 rounded-xl border border-outline-variant/10 hover:border-secondary-fixed/40 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-full bg-surface-container-highest flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl">local_shipping</span>
          </div>
          <h3 class="font-headline text-on-surface uppercase text-lg mb-4 tracking-wider">Free Delivery Nearby</h3>
          <p class="font-body text-on-surface-variant text-sm leading-relaxed">
            Enjoy your favorite meals delivered straight to your door at no extra cost within a 1km radius.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Daily Tiffin Service -->
  <section class="relative py-32 px-6 md:px-12 bg-gradient-to-br from-surface via-surface-container-low to-surface overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-primary rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-secondary-fixed rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 mb-6">
          <span class="material-symbols-outlined text-primary text-sm">restaurant_menu</span>
          <span class="text-primary font-label tracking-[0.3em] uppercase text-xs">Corporate Catering</span>
        </div>
        <h2 class="font-headline text-4xl md:text-6xl text-secondary-fixed uppercase mb-4 leading-tight">
          Daily Tiffin <span class="text-primary">Service</span>
        </h2>
        <p class="font-body text-on-surface-variant max-w-2xl mx-auto text-lg leading-relaxed">
          Elevate your corporate dining experience with our chef-curated tiffin service. Fresh, nutritious meals delivered daily to your workplace.
        </p>
      </div>

      <!-- Main Content Card -->
      <div class="relative">
        <div class="absolute -top-4 -left-4 w-24 h-24 bg-primary/20 rounded-full blur-xl"></div>
        <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-secondary-fixed/20 rounded-full blur-xl"></div>

        <div class="bg-surface-container-highest/80 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[600px]">
            <!-- Image Section -->
            <div class="relative group overflow-hidden h-72 sm:h-96 lg:h-auto">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-secondary-fixed/20 z-10"></div>
              <img alt="Premium corporate tiffin service with gourmet meal boxes" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDGr2r-rmCSiTsYoLW6vSTvJPhQqpaWUp7konQxTbdrYWOB5izkSIOBXWLMJvCEBBYe7Dv8o9HDaMbs74fbPonHSUy7p4OWYqNkZwoHJc6muNcYVJPL00ezfLevZLLbARAD_RhOiJZMhPxIqSSaEWFL2HjV1NHcPm93Rv13EpZUHC5jBIyTpnynOtaoYUu4uSFCSCjBQAOaXI9dm67-LWF_uCK1MrR5KLyQyh7HwAjcwaTGoEmRGaqtu0qiwkyIoeAuVKwHmK49y8E"/>
              <div class="absolute top-8 right-8 z-20">
                <div class="bg-secondary-fixed text-on-secondary-fixed px-4 py-2 rounded-full shadow-lg transform rotate-3 hover:rotate-0 transition-transform">
                  <span class="font-headline text-sm uppercase tracking-wider">Free Delivery</span>
                </div>
              </div>
              <div class="absolute bottom-8 left-8 z-20">
                <div class="bg-primary text-on-primary px-4 py-2 rounded-full shadow-lg">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm" data-weight="fill">verified</span>
                    <span class="font-headline text-sm uppercase tracking-wider">Premium Quality</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content Section -->
            <div class="p-6 sm:p-12 md:p-16 flex flex-col justify-center relative">
              <div class="absolute top-8 right-8 opacity-10">
                <span class="material-symbols-outlined text-secondary-fixed text-8xl">lunch_dining</span>
              </div>
              <div class="relative z-10">
                <h3 class="font-headline text-3xl md:text-4xl text-on-surface uppercase mb-6 leading-tight">
                  Chef-Curated <br />
                  <span class="text-primary">Office Meals</span>
                </h3>
                <p class="font-body text-on-surface-variant text-lg mb-10 leading-relaxed">
                  Transform your workday with our rotating menu of 30+ gourmet dishes. Each tiffin is freshly prepared with premium ingredients, balanced nutrition, and culinary excellence.
                </p>

                <!-- Feature Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-12">
                  <div class="group">
                    <div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container/50 border border-white/5 hover:border-primary/30 transition-all duration-300 hover:shadow-lg">
                      <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                        <span class="material-symbols-outlined text-primary text-xl">restaurant</span>
                      </div>
                      <div>
                        <h4 class="font-headline text-on-surface uppercase text-sm mb-2 tracking-wider">Diverse Menu</h4>
                        <p class="font-body text-on-surface-variant text-sm">30+ rotating dishes weekly</p>
                      </div>
                    </div>
                  </div>
                  <div class="group">
                    <div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container/50 border border-white/5 hover:border-primary/30 transition-all duration-300 hover:shadow-lg">
                      <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                        <span class="material-symbols-outlined text-primary text-xl">schedule</span>
                      </div>
                      <div>
                        <h4 class="font-headline text-on-surface uppercase text-sm mb-2 tracking-wider">Fresh Daily</h4>
                        <p class="font-body text-on-surface-variant text-sm">Prepared fresh every morning</p>
                      </div>
                    </div>
                  </div>
                  <div class="group">
                    <div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container/50 border border-white/5 hover:border-primary/30 transition-all duration-300 hover:shadow-lg">
                      <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                        <span class="material-symbols-outlined text-primary text-xl">local_shipping</span>
                      </div>
                      <div>
                        <h4 class="font-headline text-on-surface uppercase text-sm mb-2 tracking-wider">Free Delivery</h4>
                        <p class="font-body text-on-surface-variant text-sm">Within 1km radius</p>
                      </div>
                    </div>
                  </div>
                  <div class="group">
                    <div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container/50 border border-white/5 hover:border-primary/30 transition-all duration-300 hover:shadow-lg">
                      <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                        <span class="material-symbols-outlined text-primary text-xl">payments</span>
                      </div>
                      <div>
                        <h4 class="font-headline text-on-surface uppercase text-sm mb-2 tracking-wider">Value Pricing</h4>
                        <p class="font-body text-on-surface-variant text-sm">Corporate plans available</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- CTA Section -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pt-8 border-t border-white/10">
                  <a href="/tiffin" class="group bg-primary text-on-primary px-8 py-4 rounded-xl font-headline tracking-widest text-sm uppercase hover:bg-primary-fixed transition-all duration-300 hover:shadow-lg hover:shadow-primary/25 transform hover:-translate-y-1 inline-block">
                    <span class="flex items-center gap-2">
                      View Subscription Plans
                      <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </span>
                  </a>
                  <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-secondary-fixed/10 border border-secondary-fixed/20">
                    <span class="material-symbols-outlined text-secondary-fixed" data-weight="fill">workspace_premium</span>
                    <span class="font-label text-secondary-fixed text-sm uppercase tracking-wider">Trusted by 50+ Companies</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-32 px-6 md:px-12 bg-surface-container-low">
    <div class="max-w-7xl mx-auto">
      <div class="mb-20 text-center">
        <span class="text-primary font-label tracking-[0.4em] uppercase text-xs mb-4 block">Guest Experiences</span>
        <h2 class="font-headline text-4xl md:text-6xl text-secondary-fixed uppercase">What Customers Say</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Review 1 -->
        <div class="bg-surface-container-highest p-10 rounded-xl border border-outline-variant/10 flex flex-col justify-between group hover:border-secondary-fixed/30 transition-colors">
          <div>
            <div class="flex gap-1 mb-6 text-secondary-fixed">
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1">star</span>
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1">star</span>
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1">star</span>
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1">star</span>
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1">star</span>
            </div>
            <p class="font-headline text-xl text-on-surface mb-8 italic leading-relaxed">"Best grilled food in Surat, must try!"</p>
          </div>
          <div class="flex items-center gap-4">
