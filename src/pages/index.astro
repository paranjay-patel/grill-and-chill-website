    <!-- Client-side script for tab selector -->
    <script is:inline>
      function initTiffinTabs() {
        const tabBtns = document.querySelectorAll('.tiffin-tab-btn');
        const contents = document.querySelectorAll('.tiffin-menu-content');
        
        if (!tabBtns.length || !contents.length) return;
        
        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const targetDay = btn.getAttribute('data-day');
            
            // Set buttons active/inactive
            tabBtns.forEach(b => {
              if (b === btn) {
                b.classList.add('bg-primary', 'text-[#680008]');
                b.classList.remove('text-primary/70');
              } else {
                b.classList.remove('bg-primary', 'text-[#680008]');
                b.classList.add('text-primary/70');
              }
            });
            
            // Fade out current active content, then show the new one
            contents.forEach(content => {
              if (content.id === `tiffin-menu-${targetDay}`) {
                content.classList.remove('hidden');
                // Allow a small delay to trigger the transition
                setTimeout(() => {
                  content.classList.remove('opacity-0');
                  content.classList.add('opacity-100');
                }, 50);
              } else {
                content.classList.remove('opacity-100');
                content.classList.add('opacity-0');
                // Ensure it's display hidden after transition completes
                setTimeout(() => {
                  content.classList.add('hidden');
                }, 300);
              }
            });
          });
        });
      }
      
      // Initialize on DOM ready and after Astro page transitions
      document.addEventListener('DOMContentLoaded', initTiffinTabs);
      document.addEventListener('astro:after-swap', initTiffinTabs);
      
      // Run once immediately in case page is already loaded
      initTiffinTabs();
    </script>
  </section>

