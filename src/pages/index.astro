                  <a class="inline-flex items-center gap-1.5 text-primary hover:text-white font-label tracking-widest text-[10px] uppercase hover:gap-3 transition-all" href={RESTAURANT.mapsLink} target="_blank" rel="noopener noreferrer">
                    Get Directions <span class="material-symbols-outlined text-xs">open_in_new</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Hours Details -->
            <div class="glass-card-spotlight p-6 rounded-2xl border border-white/10 shadow-lg relative">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 text-primary">
                  <span class="material-symbols-outlined text-lg">schedule</span>
                </div>
                <div class="flex-grow space-y-2">
                  <div class="flex justify-between items-center">
                    <h4 class="font-label text-xs uppercase tracking-widest font-bold text-white">Service Hours</h4>
                    <!-- Live Status Badge -->
                    <span id="live-status-badge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-label font-bold uppercase tracking-wider bg-zinc-800 border border-zinc-700 text-zinc-400">
                      <span class="relative flex h-1.5 w-1.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-1.5 w-1.5"></span>
                      </span>
                      <span id="live-status-text">Checking...</span>
                    </span>
                  </div>
                  <p class="font-body text-xs sm:text-sm text-[#dac1bf]">{RESTAURANT.timings}</p>
                </div>
              </div>
            </div>

            <!-- Contact Details -->
            <div class="glass-card-spotlight p-6 rounded-2xl border border-white/10 shadow-lg relative">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 text-primary">
                  <span class="material-symbols-outlined text-lg">contact_phone</span>
                </div>
                <div class="space-y-3 flex-grow">
                  <h4 class="font-label text-xs uppercase tracking-widest font-bold text-white">Get In Touch</h4>
                  <div class="flex flex-wrap gap-x-6 gap-y-2 font-body text-xs sm:text-sm text-[#dac1bf]">
