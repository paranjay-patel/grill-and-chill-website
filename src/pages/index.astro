---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { RESTAURANT, RESTAURANT_PHONE_LINK, RESTAURANT_WHATSAPP_LINK, RESTAURANT_EMAIL_LINK } from '../data/site-config';
import heroImage from '../assets/herosection.png';
import hearthSpacePreview from '../assets/hearth_space_preview.png';
---

<Layout title="Grill & Chill | Best Punjabi Restaurant & Tandoor in Surat" activeTab="home">
  <!-- Hero Section -->
  <section class="relative flex items-center px-6 md:px-12 overflow-hidden h-[90vh] min-h-[80vh]">
    <div class="absolute inset-0 z-0">
      <Image alt="High-end grill restaurant interior with warm lighting" class="w-full h-full object-cover opacity-100 mix-blend-luminosity object-center" src={heroImage} />
      <div class="absolute inset-0 bg-gradient-to-b from-background/95 via-background/70 to-background/50 md:bg-gradient-to-r md:from-background/95 md:via-background/50 md:to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-4xl py-12">
      <span class="inline-block px-4 py-1 mb-4 border border-outline-variant text-secondary-fixed font-label text-xs tracking-[0.3em] uppercase rounded-full bg-background/40 backdrop-blur-md">
        Best Restaurant &amp; Tandoor in Surat — Est. 2019
      </span>
      <h1 class="font-headline text-4xl sm:text-6xl md:text-8xl text-on-surface leading-[0.9] tracking-tighter mb-6 uppercase italic">
        The Art of <br />
        <span class="text-primary text-glow-premium">Fire & Spice</span>
      </h1>
      <p class="font-body text-lg md:text-xl text-on-surface-variant max-w-xl mb-10 leading-relaxed">
        A curated journey through heritage recipes, where the flame meets the finest ingredients in a dance of smoky perfection.
      </p>
      <div class="flex flex-wrap gap-6">
        <a href="/menu" class="bg-primary text-on-primary px-10 py-4 rounded-lg font-headline font-bold tracking-widest uppercase hover:bg-primary-fixed transition-colors text-center inline-block shadow-lg shadow-primary/20">
          EXPLORE THE MENU
        </a>
      </div>
    </div>
  </section>

  <!-- Culinary Categories (Symmetric Grid with Solid Premium Cards) -->
  <section class="cuisine-section py-24 md:py-28 px-6 md:px-12 relative overflow-hidden bg-[#180001]">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-16 md:mb-20">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#ffb3ac]/20 bg-surface-container-high/70 text-secondary-fixed font-label text-xs tracking-[0.35em] uppercase">
          Signature selections
        </span>
        <h2 class="font-headline text-4xl md:text-6xl text-secondary-fixed uppercase mt-6">Cuisines</h2>
        <div class="editorial-line w-24 mx-auto my-6"></div>
        <p class="font-body text-[#dac1bf] max-w-2xl mx-auto text-lg md:text-xl leading-relaxed">
          A more refined way to explore the menu, with each cuisine presented like a signature dish. Rich, layered, and designed to feel as inviting as the food itself.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Punjabi Cuisine Card -->
        <article class="cuisine-card group rounded-3xl overflow-hidden border border-white/10 glass-card-spotlight shadow-2xl flex flex-col justify-between">
          <div class="h-full flex flex-col justify-between">
            <div class="cuisine-card-media relative">
              <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCDn2K4rueHS-LK2dE7WbhNI1bpURfsXyY4T9bwc_Osw4-Q1YTYu6ZKDZhFqOTWdsMn387S-1JNwPFdmKnmoauWdyye1whNmhtDtL2jzlYenlpar-UmCKBlai4TldrWOQEkEo-gwBoIzPdnl86i2wWc5GbOpQCZI2YOKmO-rc4wQ0kH0pn-I3Kp-5HF_icc7cr87PlUPmIPG9tpzTUT-6xy2y5AxcB6WLXQ99s2BjW7CTtLMfEh76s_8xa_zJYtOCuPqwPHhPYMqI8" alt="Punjabi cuisine" loading="lazy" class="cuisine-card-image w-full h-full object-cover"/>
              <div class="absolute inset-0 bg-gradient-to-t from-[#1e0304]/90 via-[#1e0304]/30 to-transparent"></div>
              <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-primary/30 to-transparent"></div>
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="cuisine-badge">01</span>
                <span class="cuisine-chip">Heritage</span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-4">
                <div>
                  <p class="text-[0.72rem] uppercase tracking-[0.25em] text-[#ffe16d] font-label mb-1 font-extrabold">Smoky indulgence</p>
                  <h3 class="font-headline text-3xl font-black text-white uppercase leading-none">Punjabi</h3>
                </div>
                <div class="text-right">
                  <p class="text-[0.68rem] uppercase tracking-[0.2em] text-white/50 font-label">Signature</p>
                  <p class="text-sm text-white/95 font-body font-bold mt-0.5">Paneer Angara</p>
                </div>
              </div>
            </div>
            <div class="p-7 md:p-8 flex-grow flex flex-col justify-between">
              <p class="font-body text-[#dac1bf] leading-relaxed mb-6">
                Hearty tandoori dishes, rich curries, and freshly baked breads brought together with a deep, comforting spice profile.
              </p>
              <div>
                <div class="flex flex-wrap gap-2 mb-7">
                  <span class="cuisine-tag">Tandoori</span>
                  <span class="cuisine-tag">Fresh breads</span>
                  <span class="cuisine-tag">Bold gravies</span>
                </div>
                <a href="/menu#punjabi" class="cuisine-link">
                  Explore menu
                  <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- Chinese Cuisine Card -->
        <article class="cuisine-card group rounded-3xl overflow-hidden border border-white/10 glass-card-spotlight shadow-2xl flex flex-col justify-between">
          <div class="h-full flex flex-col justify-between">
            <div class="cuisine-card-media relative">
              <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuB4sDMmFxe_CA2sUcgbymzArzMIGLlsKmCaUgyeVnTieKYB4-_qNlbJrSL2kNY8re-6oOrfuyzeQ5fYg7GNxD7MdgU0NBDQq1LCCHjlcEMNwiPe5U-BvpIN314HdD7jwCLkgmgZCgzkvuvAtF-PoBfqfjfTFq88tXp9-GbZDvPsS7WtMlHkvwUX5GZvt5DqcdQQ-BeWyjD4p9C1BYii-pn_GS41HD_5VqcnRyLGuvGAYem0Xt-Rz8VBlaVVPSegOpo2B346sN7fHQM" alt="Chinese cuisine" loading="lazy" class="cuisine-card-image w-full h-full object-cover"/>
              <div class="absolute inset-0 bg-gradient-to-t from-[#1e0304]/90 via-[#1e0304]/30 to-transparent"></div>
              <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-primary/30 to-transparent"></div>
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="cuisine-badge">02</span>
                <span class="cuisine-chip">Wok-fired</span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-4">
                <div>
                  <p class="text-[0.72rem] uppercase tracking-[0.25em] text-[#ffe16d] font-label mb-1 font-extrabold">Fast, fresh, fragrant</p>
                  <h3 class="font-headline text-3xl font-black text-white uppercase leading-none">Chinese</h3>
                </div>
                <div class="text-right">
                  <p class="text-[0.68rem] uppercase tracking-[0.2em] text-white/50 font-label">Signature</p>
                  <p class="text-sm text-white/95 font-body font-bold mt-0.5">Manchurian</p>
                </div>
              </div>
            </div>
            <div class="p-7 md:p-8 flex-grow flex flex-col justify-between">
              <p class="font-body text-[#dac1bf] leading-relaxed mb-6">
                Crisp vegetables, bold sauces, and wok-fresh stir fries with the kind of balance that keeps every bite lively and memorable.
              </p>
              <div>
                <div class="flex flex-wrap gap-2 mb-7">
                  <span class="cuisine-tag">Stir fry</span>
                  <span class="cuisine-tag">Dim sum</span>
                  <span class="cuisine-tag">Saucy classics</span>
                </div>
                <a href="/menu#chinese" class="cuisine-link">
                  Explore menu
                  <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- Chicken Cuisine Card -->
        <article class="cuisine-card group rounded-3xl overflow-hidden border border-white/10 glass-card-spotlight shadow-2xl flex flex-col justify-between">
          <div class="h-full flex flex-col justify-between">
            <div class="cuisine-card-media relative">
              <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAtkNeHyzWfjXzxFIPimqDlXzo7a4t0cST2-mCq7NOdW76wGrnvFoqh6wyI0hYZSbvC8sPHK4K41_z7PUz1wMg-wgLgqgzeja0vR6n1kaf2YVzbMevYxki2YPe8qGNWhFQ0gK065zYqukSVNCTZtuL3rbFXv_a0tN-BZu8YlXjdzSpYV15_GK7biGV9vCBM0hLBGTLQe6QURbl3YEml6UJVijnF9XjPqCyCNw9jxcpDBKDYimuY0BJnlryI81AR0mYrPY38k_pV9Wk" alt="Chicken cuisine" loading="lazy" class="cuisine-card-image w-full h-full object-cover"/>
              <div class="absolute inset-0 bg-gradient-to-t from-[#1e0304]/90 via-[#1e0304]/30 to-transparent"></div>
              <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-primary/30 to-transparent"></div>
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="cuisine-badge">03</span>
                <span class="cuisine-chip">Chef Special</span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-4">
                <div>
                  <p class="text-[0.72rem] uppercase tracking-[0.25em] text-[#ffe16d] font-label mb-1 font-extrabold">Grilled comfort</p>
                  <h3 class="font-headline text-3xl font-black text-white uppercase leading-none">Chicken</h3>
                </div>
                <div class="text-right">
                  <p class="text-[0.68rem] uppercase tracking-[0.2em] text-white/50 font-label">Signature</p>
                  <p class="text-sm text-white/95 font-body font-bold mt-0.5">Chicken Biryani</p>
                </div>
              </div>
            </div>
            <div class="p-7 md:p-8 flex-grow flex flex-col justify-between">
              <p class="font-body text-[#dac1bf] leading-relaxed mb-6">
                Char-grilled chicken dishes with balanced marinades, slow-cooked depth, and modern plating that feels elevated without losing warmth.
              </p>
              <div>
                <div class="flex flex-wrap gap-2 mb-7">
                  <span class="cuisine-tag">Grilled</span>
                  <span class="cuisine-tag">Marinated</span>
                  <span class="cuisine-tag">Comfort food</span>
                </div>
                <a href="/menu#chicken" class="cuisine-link">
                  Explore menu
                  <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      </div>

      <div class="mt-14 text-center">
        <a href="/menu" class="inline-flex items-center gap-3 px-10 md:px-14 py-4 rounded-full bg-secondary-fixed text-on-secondary-fixed font-bold tracking-widest uppercase shadow-lg shadow-black/15 hover:bg-secondary-container hover:shadow-black/20 transition-all">
          View Full Menu
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section (Dark Premium Theme with Rich Contrast) -->
  <section class="py-32 px-6 md:px-12 bg-gradient-to-b from-[#180001] via-[#1c0102] to-[#210103] border-y border-white/5 relative overflow-hidden">
    <!-- Subtle background glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="mb-20 text-center">
        <span class="text-primary font-label tracking-[0.4em] uppercase text-xs mb-4 block font-extrabold">Our Commitment</span>
        <h2 class="font-headline text-4xl md:text-6xl text-secondary-fixed uppercase font-black">WHY CHOOSE US</h2>
        <div class="w-24 h-1 bg-primary mx-auto mt-6 opacity-30"></div>
      </div>
      <div class="bento-grid gap-6">
        <!-- Point 1 (Bento Span 4) -->
        <div class="bento-card bento-span-4 glass-card-spotlight p-8 md:p-10 rounded-2xl border border-white/10 hover:border-primary/20 shadow-2xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-[#680008] transition-all duration-300 text-primary">
              <span class="material-symbols-outlined text-3xl">restaurant</span>
            </div>
            <h3 class="font-headline text-[#ffe16d] uppercase text-xl mb-4 tracking-wider font-extrabold">Freshly Cooked, Not Pre-made</h3>
            <p class="font-body text-[#dac1bf]/90 text-base leading-relaxed">
              Every dish is prepared from scratch when you order, ensuring the highest quality, rich authentic spices, and piping hot taste.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/10 flex justify-between items-center text-xs font-label uppercase tracking-widest text-primary font-extrabold">
            <span>Made on order</span>
            <span class="material-symbols-outlined text-sm">check_circle</span>
          </div>
        </div>

        <!-- Point 2 (Bento Span 2) -->
        <div class="bento-card bento-span-2 glass-card-spotlight p-8 rounded-2xl border border-white/10 hover:border-primary/20 shadow-2xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-[#680008] transition-all duration-300 text-primary">
              <span class="material-symbols-outlined text-3xl">set_meal</span>
            </div>
            <h3 class="font-headline text-[#ffe16d] uppercase text-lg mb-4 tracking-wider font-extrabold">Combos & Thalis</h3>
            <p class="font-body text-[#dac1bf]/90 text-sm leading-relaxed">
              Budget-friendly and complete meal sets showcasing diverse Punjabi & Chinese flavors.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/10 flex justify-between items-center text-[10px] font-label uppercase tracking-widest text-primary font-extrabold">
            <span>Great value</span>
            <span class="material-symbols-outlined text-sm">payments</span>
          </div>
        </div>

        <!-- Point 3 (Bento Span 2) -->
        <div class="bento-card bento-span-2 glass-card-spotlight p-8 rounded-2xl border border-white/10 hover:border-primary/20 shadow-2xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-[#680008] transition-all duration-300 text-primary">
              <span class="material-symbols-outlined text-3xl">speed</span>
            </div>
            <h3 class="font-headline text-[#ffe16d] uppercase text-lg mb-4 tracking-wider font-extrabold">Quick Service</h3>
            <p class="font-body text-[#dac1bf]/90 text-sm leading-relaxed">
              Fresh takeaway or dine-in, structured for high speed without compromising absolute flavor.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/10 flex justify-between items-center text-[10px] font-label uppercase tracking-widest text-primary font-extrabold">
            <span>Fast turnaround</span>
            <span class="material-symbols-outlined text-sm">bolt</span>
          </div>
        </div>

        <!-- Point 4 (Bento Span 4) -->
        <div class="bento-card bento-span-4 glass-card-spotlight p-8 md:p-10 rounded-2xl border border-white/10 hover:border-primary/20 shadow-2xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-full bg-[#310002]/90 border border-primary/20 flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-[#680008] transition-all duration-300 text-primary">
              <span class="material-symbols-outlined text-3xl">local_shipping</span>
            </div>
            <h3 class="font-headline text-[#ffe16d] uppercase text-xl mb-4 tracking-wider font-extrabold">Free Delivery Nearby</h3>
            <p class="font-body text-[#dac1bf]/90 text-base leading-relaxed">
              Order your tandoori items or daily curries and enjoy free shipping straight to your doorstep (within a 1km radius).
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/10 flex justify-between items-center text-xs font-label uppercase tracking-widest text-primary font-extrabold">
            <span>Surat Adajan & Magdalla</span>
            <span class="material-symbols-outlined text-sm">home</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Daily Tiffin Service (Elegant, Modern, High Contrast & Interactive) -->
  <section class="relative py-32 px-6 md:px-12 bg-gradient-to-b from-[#210103] via-[#150001] to-[#250103] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-primary rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#ffe16d] rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto z-10">
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 mb-6">
          <span class="material-symbols-outlined text-primary text-sm">restaurant_menu</span>
          <span class="text-primary font-label tracking-[0.3em] uppercase text-xs">Fresh Daily Catering</span>
        </div>
        <h2 class="font-headline text-4xl md:text-6xl text-secondary-fixed uppercase mb-4 leading-tight">
          Daily Tiffin Service
        </h2>
        <p class="font-body text-[#dac1bf] max-w-2xl mx-auto text-lg leading-relaxed">
          Elevate your corporate dining experience with our chef-curated tiffin service. Fresh, nutritious meals delivered daily to your workplace.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">
        <!-- Left: Image & Timeline (Col-Span-5) -->
        <div class="lg:col-span-5 flex flex-col justify-between gap-8">
          <!-- Premium Image Card -->
          <div class="relative rounded-3xl overflow-hidden aspect-[16/10] border border-white/15 shadow-2xl group">
            <div class="absolute inset-0 bg-gradient-to-t from-[#150001] via-transparent to-transparent z-10"></div>
            <img alt="Premium corporate tiffin service with gourmet meal boxes" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDGr2r-rmCSiTsYoLW6vSTvJPhQqpaWUp7konQxTbdrYWOB5izkSIOBXWLMJvCEBBYe7Dv8o9HDaMbs74fbPonHSUy7p4OWYqNkZwoHJc6muNcYVJPL00ezfLevZLLbARAD_RhOiJZMhPxIqSSaEWFL2HjV1NHcPm93Rv13EpZUHC5jBIyTpnynOtaoYUu4uSFCSCjBQAOaXI9dm67-LWF_uCK1MrR5KLyQyh7HwAjcwaTGoEmRGaqtu0qiwkyIoeAuVKwHmK49y8E"/>
            <div class="absolute top-4 right-4 z-20">
              <span class="bg-[#ffe16d] text-[#310002] px-3.5 py-1.5 rounded-full shadow-lg font-headline text-[10px] uppercase tracking-wider font-black">Free Delivery</span>
            </div>
            <div class="absolute bottom-4 left-4 z-20">
              <div class="bg-primary text-on-primary px-3.5 py-1.5 rounded-full shadow-lg flex items-center gap-1.5">
                <span class="material-symbols-outlined text-xs" data-weight="fill">verified</span>
                <span class="font-headline text-[10px] uppercase tracking-wider font-bold">Premium Quality</span>
              </div>
            </div>
          </div>

          <!-- Timeline Promise -->
          <div class="glass-card-spotlight border border-white/10 rounded-3xl p-8 flex-grow">
            <h3 class="font-headline text-lg text-[#ffe16d] uppercase tracking-widest mb-6 font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-[#ffe16d]">electric_bolt</span>
              The Tiffin Promise
            </h3>
            
            <div class="relative pl-6 border-l border-primary/20 space-y-6">
              <!-- Step 1 -->
              <div class="relative">
                <div class="absolute -left-[31px] top-0 w-4.5 h-4.5 rounded-full bg-[#150001] border-2 border-primary flex items-center justify-center">
                   <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                </div>
                <h4 class="font-headline text-xs text-white uppercase tracking-wider font-extrabold mb-1">09:00 AM — Fresh Sourcing</h4>
                <p class="font-body text-[#dac1bf] text-xs leading-relaxed">Daily handpicked fresh vegetables and premium spices arrive at our kitchen.</p>
              </div>

              <!-- Step 2 -->
              <div class="relative">
                <div class="absolute -left-[31px] top-0 w-4.5 h-4.5 rounded-full bg-[#150001] border-2 border-[#ffe16d] flex items-center justify-center">
                  <div class="w-1.5 h-1.5 rounded-full bg-[#ffe16d]"></div>
                </div>
                <h4 class="font-headline text-xs text-white uppercase tracking-wider font-extrabold mb-1">11:00 AM — Slow Cooked & Sealed</h4>
                <p class="font-body text-[#dac1bf] text-xs leading-relaxed">Prepared in small batches with low oil and packed into premium insulated hot-cases.</p>
              </div>

              <!-- Step 3 -->
              <div class="relative">
                <div class="absolute -left-[31px] top-0 w-4.5 h-4.5 rounded-full bg-[#150001] border-2 border-primary flex items-center justify-center">
                  <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                </div>
                <h4 class="font-headline text-xs text-white uppercase tracking-wider font-extrabold mb-1">12:30 PM — Desk Delivery</h4>
                <p class="font-body text-[#dac1bf] text-xs leading-relaxed">Dispatched instantly to guarantee hot and fresh lunch boxes at your office table.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Interactive Tiffin Menu Widget (Col-Span-7) -->
        <div class="lg:col-span-7">
          <div class="relative glass-card-spotlight border border-white/10 rounded-3xl p-8 md:p-10 shadow-2xl h-full flex flex-col justify-between overflow-hidden">
            <!-- Glow effect -->
            <div class="absolute -top-12 -right-12 w-48 h-48 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
                <div>
                  <h3 class="font-headline text-2xl text-white uppercase font-black tracking-wide">Weekly Menu Preview</h3>
                  <p class="font-body text-[#dac1bf] text-sm mt-1">Select a day to see what's in our premium hot-case</p>
