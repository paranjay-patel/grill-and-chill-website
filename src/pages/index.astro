                    <a class="flex items-center gap-2 hover:text-white transition-colors" href={RESTAURANT_EMAIL_LINK}>
                      <span class="material-symbols-outlined text-sm text-primary">mail</span>
                      <span>{RESTAURANT.email}</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-4 pt-2">
            <a href="https://wa.me/918980356776?text=Hi%2C%20I%20want%20to%20book%20a%20table%20at%20Grill%20%26%20Chill" target="_blank" rel="noopener noreferrer" class="flex-grow sm:flex-grow-0 bg-primary text-[#680008] hover:bg-primary-fixed hover:scale-105 px-8 py-4 rounded-xl font-headline tracking-widest text-xs uppercase font-extrabold transition-all duration-300 shadow-lg shadow-primary/10 text-center flex items-center justify-center">
              Book A Table
            </a>
            <a href={RESTAURANT_WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="flex-grow sm:flex-grow-0 bg-green-600 hover:bg-green-700 text-white hover:scale-105 px-8 py-4 rounded-xl font-headline tracking-widest text-xs uppercase font-extrabold transition-all duration-300 shadow-lg shadow-green-900/20 flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-base">chat</span> WhatsApp Chat
            </a>
          </div>
        </div>

        <!-- Right Side: Interactive Console (col-span-7) -->
        <div class="lg:col-span-7 w-full">
          <div class="relative w-full h-[450px] sm:h-[520px] rounded-3xl overflow-hidden border border-white/10 bg-[#250507] shadow-[0_30px_70px_rgba(0,0,0,0.8)] flex flex-col justify-between group">
            
            <!-- Window Tab Bar -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5 bg-background/50 backdrop-blur-md z-20">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
