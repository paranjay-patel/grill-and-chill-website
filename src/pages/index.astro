              </div>

              <!-- Space Preview Container -->
              <div id="space-view-container" class="absolute inset-0 z-0 transition-opacity duration-500 opacity-0 pointer-events-none">
                <Image alt="Cozy dining room and open flame cooking hearth at Grill & Chill" class="w-full h-full object-cover" src={hearthSpacePreview} />
                <div class="absolute inset-0 bg-gradient-to-t from-[#250507]/90 via-transparent to-black/30"></div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Script for Visit Us section -->
  <script>
    function initVisitUsSection() {
      // 1. Tab switching for Map vs Space Preview
      const mapBtn = document.getElementById('view-map-btn');
      const spaceBtn = document.getElementById('view-space-btn');
      const mapContainer = document.getElementById('map-view-container');
      const spaceContainer = document.getElementById('space-view-container');

      if (mapBtn && spaceBtn && mapContainer && spaceContainer) {
        mapBtn.addEventListener('click', () => {
          mapBtn.className = 'px-4 py-1.5 rounded-full font-label font-bold text-[10px] uppercase tracking-wider bg-primary text-[#680008] shadow-lg transition-all duration-300';
          spaceBtn.className = 'px-4 py-1.5 rounded-full font-label font-bold text-[10px] uppercase tracking-wider text-on-surface-variant hover:text-on-surface transition-all duration-300';
          
          mapContainer.classList.remove('opacity-0', 'pointer-events-none');
          mapContainer.classList.add('opacity-100');
          mapContainer.style.zIndex = '10';

          spaceContainer.classList.remove('opacity-100');
          spaceContainer.classList.add('opacity-0', 'pointer-events-none');
          spaceContainer.style.zIndex = '0';
        });

        spaceBtn.addEventListener('click', () => {
          spaceBtn.className = 'px-4 py-1.5 rounded-full font-label font-bold text-[10px] uppercase tracking-wider bg-primary text-[#680008] shadow-lg transition-all duration-300';
          mapBtn.className = 'px-4 py-1.5 rounded-full font-label font-bold text-[10px] uppercase tracking-wider text-on-surface-variant hover:text-on-surface transition-all duration-300';
          
          spaceContainer.classList.remove('opacity-0', 'pointer-events-none');
          spaceContainer.classList.add('opacity-100');
          spaceContainer.style.zIndex = '10';

          mapContainer.classList.remove('opacity-100');
          mapContainer.classList.add('opacity-0', 'pointer-events-none');
          mapContainer.style.zIndex = '0';
        });
      }

      // 2. Live Status Badge logic
      const statusTextEl = document.getElementById('live-status-text');
      const statusDotEl = document.querySelector('#live-status-badge .relative.inline-flex');
      const statusPingEl = document.querySelector('#live-status-badge .animate-ping');
      const statusContainer = document.getElementById('live-status-badge');

      if (statusTextEl && statusDotEl && statusPingEl && statusContainer) {
        const now = new Date();
        const currentHour = now.getHours();
        // 11:00 to 23:00 (11 AM to 11 PM)
        const isOpen = currentHour >= 11 && currentHour < 23;

        if (isOpen) {
          statusTextEl.textContent = 'Open Now';
          statusContainer.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-label font-bold uppercase tracking-wider bg-green-500/10 border border-green-500/30 text-green-400';
          statusDotEl.className = 'relative inline-flex rounded-full h-1.5 w-1.5 bg-green-500';
          statusPingEl.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75';
        } else {
          statusTextEl.textContent = 'Closed';
          statusContainer.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-label font-bold uppercase tracking-wider bg-red-500/10 border border-red-500/30 text-red-400';
          statusDotEl.className = 'relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500';
          statusPingEl.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75';
        }
      }
    }

    // Initialize scripts on first load and view transition swap
    initVisitUsSection();
    document.addEventListener('astro:after-swap', initVisitUsSection);
  </script>
</Layout>
