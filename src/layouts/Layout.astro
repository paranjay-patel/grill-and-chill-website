---
import '../styles/global.css';
import { 
  RESTAURANT, 
  RESTAURANT_WHATSAPP_LINK, 
  RESTAURANT_PHONE_LINK, 
  RESTAURANT_EMAIL_LINK 
} from '../data/site-config';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import FeedbackModal from '../components/FeedbackModal.astro';
import BookingModal from '../components/BookingModal.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  activeTab?: 'home' | 'menu' | 'catering' | 'tiffin' | 'zomato';
  ogImage?: string;
}

const { 
  title = "Grill & Chill | Best Punjabi Restaurant & Tandoor in Surat", 
  description = "Experience the art of fire & spice at Grill & Chill Surat. Indulge in premium tandoor dishes, heritage recipes, slow-cooked tiffins, and bespoke catering.",
  activeTab = 'home',
  ogImage = "https://grillandchill.in/assets/images/herosection.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://grillandchill.in");
---

<!DOCTYPE html>
<html class="dark scroll-smooth" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Grill and Chill Surat, restaurant in Surat, tandoor Surat, corporate tiffin Surat, best food in Surat, catering services Surat, non veg restaurant Surat" />
  <meta name="author" content="Grill & Chill" />
  <link rel="canonical" href={canonicalURL.href} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Grill & Chill" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL.href} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;700;800;900&family=Manrope:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Work+Sans:wght@400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
  
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "Grill & Chill",
    "image": "https://grillandchill.in/assets/images/herosection.png",
    "url": "https://grillandchill.in",
    "telephone": "+918980356776",
    "priceRange": "$$",
    "menu": "https://grillandchill.in/menu",
    "servesCuisine": ["Punjabi", "Indian", "Tandoori", "Chinese"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Besides dumas resort, near V R mall circle, new magdalla road, Magdalla",
      "addressLocality": "Surat",
      "addressRegion": "Gujarat",
      "postalCode": "395007",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 21.146208,
      "longitude": 72.759325
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "11:00",
      "closes": "23:00"
    },
    "sameAs": [
      "https://www.instagram.com/grill.and.chill_/"
    ]
  }
  </script>
</head>

<body class="bg-background text-on-surface font-body selection:bg-primary selection:text-on-primary overflow-x-hidden relative">
  <!-- Custom Cursor Elements -->
  <div id="custom-cursor" class="hidden lg:block"></div>
  <div id="custom-cursor-dot" class="hidden lg:block"></div>

  <!-- Background Morphing Blobs -->
  <div class="morphing-blob-container">
    <div class="morphing-blob top-0 left-[-10%]"></div>
    <div class="morphing-blob-2 top-[35%] right-[-15%]"></div>
    <div class="morphing-blob-3 bottom-[5%] left-[-5%]"></div>
  </div>



  <!-- TopAppBar -->
  <header class="fixed top-0 w-full z-50 bg-[#310002]/70 backdrop-blur-xl shadow-2xl shadow-[#290003]/40">
    <div class="bg-[#200001] border-b border-primary/20 py-2 px-4 md:px-12 flex justify-between items-center text-[10px] md:text-xs font-label tracking-[0.2em] text-secondary-fixed/90 uppercase overflow-x-auto no-scrollbar gap-4">
      <div class="flex items-center gap-4 md:gap-6 flex-shrink-0">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[14px] text-primary">location_on</span>
          <span>{RESTAURANT.location}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[14px] text-primary">schedule</span>
          <span data-restaurant-text="timings">{RESTAURANT.timingsDisplay}</span>
          <span class="live-status inline-flex items-center gap-1.5 ml-2 font-headline text-[9px] md:text-[10px] tracking-wider font-extrabold uppercase text-on-surface-variant/60 align-middle">
            <span class="relative flex h-2 w-2">
              <span class="relative inline-flex rounded-full h-2 w-2 bg-neutral-500"></span>
            </span>
            Checking...
          </span>
        </div>
      </div>
      <div class="flex items-center gap-4 md:gap-6 flex-shrink-0">
        <a class="flex items-center gap-1.5 hover:text-secondary-fixed transition-colors" href={RESTAURANT_PHONE_LINK}>
          <span class="material-symbols-outlined text-[14px] text-primary">call</span>
          <span>{RESTAURANT.displayPhone}</span>
        </a>
        <a class="flex items-center gap-1.5 hover:text-green-400 transition-colors" href={RESTAURANT_WHATSAPP_LINK} target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined text-[14px] text-green-500">chat</span>
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
    <nav class="flex justify-between items-center px-4 md:px-12 w-full max-w-none py-3 gap-2">
      <a href="/" class="flex items-center gap-3 font-headline flex-shrink-0 group">
        <img src="/assets/images/favicon.png" alt="Grill &amp; Chill Logo" class="w-10 h-10 object-contain rounded-full border border-primary/20 group-hover:scale-105 transition-transform" />
        <span class="text-xl md:text-2xl font-bold tracking-tighter text-[#FFB3AC]">GRILL &amp; CHILL</span>
      </a>
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <a class={`hover:text-[#FFB3AC] transition-colors font-headline font-bold text-sm tracking-widest uppercase ${activeTab === 'home' ? 'active-nav-link' : 'text-[#FFB3AC]/80'}`} href="/">Home</a>
        <a class={`hover:text-[#FFB3AC] transition-colors font-headline font-bold text-sm tracking-widest uppercase ${activeTab === 'menu' ? 'active-nav-link' : 'text-[#FFB3AC]/80'}`} href="/menu">menu</a>
        <a class={`hover:text-[#FFB3AC] transition-colors font-headline font-bold text-sm tracking-widest uppercase ${activeTab === 'catering' ? 'active-nav-link' : 'text-[#FFB3AC]/80'}`} href="/catering">catering</a>
        <a class={`hover:text-[#FFB3AC] transition-colors font-headline font-bold text-sm tracking-widest uppercase ${activeTab === 'tiffin' ? 'active-nav-link' : 'text-[#FFB3AC]/80'}`} href="/tiffin">tiffin</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="/zomato" class={`px-3 py-1.5 md:px-6 md:py-2.5 rounded-lg font-headline text-[10px] md:text-xs tracking-widest uppercase active:scale-90 transition-transform hover:shadow-lg hover:shadow-primary/20 font-bold scale-100 whitespace-nowrap ${activeTab === 'zomato' ? 'bg-[#FFB3AC] text-[#680008]' : 'bg-secondary-fixed text-on-secondary-fixed'}`}>order on zomato</a>
        <button id="mobile-menu-btn" class="md:hidden text-[#FFB3AC] hover:text-white transition-colors focus:outline-none flex items-center justify-center" aria-label="Toggle Menu">
          <span class="material-symbols-outlined text-3xl">menu</span>
        </button>
      </div>
    </nav>
    <!-- Top-Docked Scroll Progress Bar -->
    <div class="absolute bottom-0 left-0 w-full h-[3px] bg-primary/10 overflow-hidden">
      <div id="scroll-progress-bar" class="h-full w-0 bg-gradient-to-r from-primary to-secondary transition-all duration-100 ease-out"></div>
    </div>
  </header>
  
  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu-overlay" class="fixed inset-0 z-50 bg-[#200001]/95 backdrop-blur-2xl flex flex-col justify-center items-center gap-8 transition-all duration-300 transform translate-x-full md:hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <button id="mobile-menu-close-btn" class="absolute top-6 right-6 text-[#FFB3AC] hover:text-white focus:outline-none" aria-label="Close Menu">
      <span class="material-symbols-outlined text-3xl">close</span>
    </button>
    <div class="flex flex-col items-center gap-2 mb-4">
      <img src="/assets/images/favicon.png" alt="Grill &amp; Chill Logo" class="w-24 h-24 object-contain rounded-full border-2 border-primary/30 shadow-xl" />
      <span class="text-2xl font-black text-[#FFB3AC] tracking-widest font-headline">GRILL &amp; CHILL</span>
    </div>
    <a class={`hover:text-white transition-colors font-headline font-bold text-2xl tracking-widest uppercase ${activeTab === 'home' ? 'active-nav-link' : 'text-[#FFB3AC]'}`} href="/">Home</a>
    <a class={`hover:text-white transition-colors font-headline font-bold text-2xl tracking-widest uppercase ${activeTab === 'menu' ? 'active-nav-link' : 'text-[#FFB3AC]'}`} href="/menu">Menu</a>
    <a class={`hover:text-white transition-colors font-headline font-bold text-2xl tracking-widest uppercase ${activeTab === 'catering' ? 'active-nav-link' : 'text-[#FFB3AC]'}`} href="/catering">Catering</a>
    <a class={`hover:text-white transition-colors font-headline font-bold text-2xl tracking-widest uppercase ${activeTab === 'tiffin' ? 'active-nav-link' : 'text-[#FFB3AC]'}`} href="/tiffin">Tiffin</a>
    <a href="/zomato" class="mt-4 px-8 py-3 rounded-lg font-headline text-sm tracking-widest uppercase bg-secondary-fixed text-on-secondary-fixed font-bold">Order on Zomato</a>
  </div>

  <!-- Main Content Slot -->
  <main class="pt-24 md:pt-20">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-[#2a0506] pt-24 pb-12 px-6 md:px-12 font-body overflow-hidden relative">
    <div class="absolute top-0 right-0 opacity-5 pointer-events-none translate-x-1/4 -translate-y-1/4">
      <span class="material-symbols-outlined text-[400px]">restaurant_menu</span>
    </div>
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 pb-16">
        <!-- Column 1: About & Contact -->
        <div class="md:col-span-5 space-y-8">
          <div class="flex items-center gap-4 mb-4">
            <img src="/assets/images/favicon.png" alt="Grill &amp; Chill Logo" class="w-16 h-16 object-contain rounded-full border border-secondary-fixed/20" />
            <div>
              <div class="text-3xl font-extrabold text-secondary-fixed font-headline tracking-tighter uppercase leading-none">{RESTAURANT.name.toUpperCase()}</div>
              <div class="text-[10px] text-primary tracking-[0.25em] uppercase font-label mt-1">{RESTAURANT.est}</div>
            </div>
          </div>
          <p class="text-on-surface-variant text-lg leading-relaxed max-w-md italic">
            An editorial culinary journey born from fire. We honor heritage recipes with a modern edge, serving
            late-night cravings in the heart of Adajan.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary-fixed mt-1">location_on</span>
              <span class="text-on-surface-variant">{RESTAURANT.address}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary-fixed">call</span>
              <a class="text-on-surface hover:text-secondary-fixed transition-colors font-semibold" href={RESTAURANT_PHONE_LINK}>{RESTAURANT.displayPhone}</a>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary-fixed">schedule</span>
              <span class="text-on-surface-variant">{RESTAURANT.timingsDisplay}</span>
            </div>
          </div>
        </div>
        <!-- Column 2: Sitemap -->
        <div class="md:col-span-3 md:pl-12">
          <h4 class="font-headline text-secondary-fixed font-bold uppercase tracking-[0.2em] text-sm mb-8 relative after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-8 after:h-0.5 after:bg-secondary-fixed">Sitemap</h4>
          <ul class="space-y-4">
            <li><a class="text-on-surface-variant hover:text-secondary-fixed transition-colors uppercase text-xs tracking-widest font-label" href="/">Home</a></li>
            <li><a class="text-on-surface-variant hover:text-secondary-fixed transition-colors uppercase text-xs tracking-widest font-label" href="/menu">The Menu</a></li>
            <li><a class="text-on-surface-variant hover:text-secondary-fixed transition-colors uppercase text-xs tracking-widest font-label" href="/catering">Catering</a></li>
            <li><a class="text-on-surface-variant hover:text-secondary-fixed transition-colors uppercase text-xs tracking-widest font-label" href="/tiffin">Tiffin Service</a></li>
            <li><a class="text-on-surface-variant hover:text-secondary-fixed transition-colors uppercase text-xs tracking-widest font-label" href="/#contact">Contact Us</a></li>
          </ul>
        </div>
        <!-- Column 3: Socials -->
        <div class="md:col-span-4 md:pl-12">
          <h4 class="font-headline text-secondary-fixed font-bold uppercase tracking-[0.2em] text-sm mb-8 relative after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-8 after:h-0.5 after:bg-secondary-fixed">Follow The Flame</h4>
          <div class="flex flex-col gap-6">
            <div class="flex gap-4">
              <a class="w-12 h-12 rounded-full border border-secondary-fixed/20 flex items-center justify-center text-secondary-fixed hover:bg-secondary-fixed hover:text-on-secondary-fixed transition-all duration-300" href={RESTAURANT.instagram} target="_blank" rel="noopener noreferrer">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.209-1.791 4-4 4zm6.406-11.845c.796 0 1.441.645 1.441 1.44s-.645 1.44-1.441 1.44c-.795 0-1.439-.645-1.439-1.44s.644-1.44 1.439-1.44z"></path>
                </svg>
                <span class="sr-only">Instagram</span>
              </a>
              <span class="w-12 h-12 rounded-full border border-secondary-fixed/20 flex items-center justify-center text-secondary-fixed opacity-40 cursor-not-allowed" aria-disabled="true" title="Coming soon">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                </svg>
                <span class="sr-only">Coming soon</span>
              </span>
            </div>
            <div class="p-6 bg-[#310002] border border-secondary-fixed/10 rounded-lg">
              <p class="text-secondary-fixed text-xs font-headline uppercase tracking-[0.25em] mb-2">Heritage Promise</p>
              <p class="text-on-surface-variant text-sm italic">"Where fire meets heritage, excellence is born."</p>
            </div>
          </div>
        </div>
      </div>
      <!-- Copyright Line -->
      <div class="border-t border-secondary-fixed/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-center">
        <p class="text-on-surface-variant/60 text-sm font-label tracking-widest uppercase">
          © 2026 Grill &amp; Chill. All rights reserved.
        </p>
        <div class="flex gap-8 text-[10px] tracking-[0.3em] uppercase text-on-surface-variant/40">
          <span class="hover:text-secondary-fixed transition-colors opacity-40 cursor-not-allowed" aria-disabled="true">Privacy</span>
          <span class="hover:text-secondary-fixed transition-colors opacity-40 cursor-not-allowed" aria-disabled="true">Terms</span>
          <span class="hover:text-secondary-fixed transition-colors opacity-40 cursor-not-allowed" aria-disabled="true">Safety</span>
        </div>
      </div>
    </div>
  </footer>
  <WhatsAppWidget />
  <FeedbackModal />
  {(activeTab === 'catering' || activeTab === 'tiffin') && <BookingModal />}
  <BackToTop />

  <!-- Core Client side Scripts -->
  <script>
    // Mobile Navigation Menu Logic
    function initMobileMenu() {
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
      const mobileMenuCloseBtn = document.getElementById('mobile-menu-close-btn');

      if (!mobileMenuBtn || !mobileMenuOverlay) return;

      mobileMenuBtn.setAttribute('aria-haspopup', 'dialog');
      mobileMenuBtn.setAttribute('aria-controls', 'mobile-menu-overlay');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');

      let previousActiveElement: HTMLElement | null = null;

      function openMobileMenu() {
        previousActiveElement = document.activeElement as HTMLElement;
        mobileMenuOverlay.classList.remove('translate-x-full');
        mobileMenuOverlay.classList.add('translate-x-0');
        document.body.classList.add('overflow-hidden');

        mobileMenuBtn.setAttribute('aria-expanded', 'true');
        mobileMenuOverlay.setAttribute('aria-hidden', 'false');

        setTimeout(() => {
          if (mobileMenuCloseBtn) {
            mobileMenuCloseBtn.focus();
          }
        }, 100);
      }

      function closeMobileMenu() {
        mobileMenuOverlay.classList.remove('translate-x-0');
        mobileMenuOverlay.classList.add('translate-x-full');
        document.body.classList.remove('overflow-hidden');

        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        mobileMenuOverlay.setAttribute('aria-hidden', 'true');

        if (previousActiveElement) {
          previousActiveElement.focus();
        } else {
          mobileMenuBtn.focus();
        }
      }

      mobileMenuBtn.addEventListener('click', openMobileMenu);

      if (mobileMenuCloseBtn) {
        mobileMenuCloseBtn.addEventListener('click', closeMobileMenu);
      }

      const overlayLinks = mobileMenuOverlay.querySelectorAll('a');
      overlayLinks.forEach(link => {
        link.addEventListener('click', closeMobileMenu);
      });

      mobileMenuOverlay.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeMobileMenu();
        } else if (e.key === 'Tab') {
          const focusables = mobileMenuOverlay.querySelectorAll('a, button');
          if (focusables.length === 0) return;
          const first = focusables[0] as HTMLElement;
          const last = focusables[focusables.length - 1] as HTMLElement;

          if (e.shiftKey) {
            if (document.activeElement === first) {
              last.focus();
              e.preventDefault();
            }
          } else {
            if (document.activeElement === last) {
              first.focus();
              e.preventDefault();
            }
          }
        }
      });

      mobileMenuOverlay.addEventListener('click', (e) => {
        if (e.target === mobileMenuOverlay) {
          closeMobileMenu();
        }
      });
    }

    // Live status checking logic
    function setupLiveStatusIndicator() {
      const liveStatus = document.querySelector('.live-status');
      if (!liveStatus) return;

      const openHour = 11;
      const closeHour = 23;

      function checkStatus() {
        let now;
        try {
          const istString = new Date().toLocaleString("en-US", { timeZone: "Asia/Kolkata" });
          now = new Date(istString);
        } catch (e) {
          now = new Date();
        }

        const currentHour = now.getHours();
        const isOpen = currentHour >= openHour && currentHour < closeHour;

        if (isOpen) {
          liveStatus.className = 'live-status inline-flex items-center gap-1.5 ml-2 font-headline text-[9px] md:text-[10px] tracking-wider font-extrabold uppercase text-green-400 align-middle';
          liveStatus.innerHTML = `
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
            </span>
            Open Now
          `;
        } else {
          liveStatus.className = 'live-status inline-flex items-center gap-1.5 ml-2 font-headline text-[9px] md:text-[10px] tracking-wider font-extrabold uppercase text-on-surface-variant/60 align-middle';
          liveStatus.innerHTML = `
            <span class="relative flex h-2 w-2">
              <span class="relative inline-flex rounded-full h-2 w-2 bg-neutral-500"></span>
            </span>
            Closed
          `;
        }
      }

      checkStatus();
      setInterval(checkStatus, 30000);
    }



    function setupCustomCursor() {
      const cursor = document.getElementById('custom-cursor');
      const cursorDot = document.getElementById('custom-cursor-dot');
      if (!cursor || !cursorDot) return;

      let mouse = { x: -100, y: -100 };
      let pos = { x: -100, y: -100 };
      let speed = 0;
      let angle = 0;

      window.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });

      function updateCursor() {
        const dx = mouse.x - pos.x;
        const dy = mouse.y - pos.y;
        pos.x += dx * 0.15;
        pos.y += dy * 0.15;

        const dist = Math.hypot(dx, dy);
        speed = Math.min(dist * 0.08, 6); // clamp speed
        angle = Math.atan2(dy, dx) * (180 / Math.PI);

        cursorDot.style.transform = `translate3d(${mouse.x}px, ${mouse.y}px, 0)`;

        // Rotate and stretch outline based on speed
        const scaleX = 1 + speed * 0.08;
        const scaleY = 1 - speed * 0.04;
        cursor.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0) rotate(${angle}deg) scale(${scaleX}, ${scaleY})`;

        requestAnimationFrame(updateCursor);
      }
      requestAnimationFrame(updateCursor);

      // Set hover event listeners
      function updateHoverables() {
        const hoverables = document.querySelectorAll('a, button, [role="button"], .cuisine-card, .menu-card, .tilt-card, .btn-magnetic');
        hoverables.forEach(item => {
          // Remove old listeners to avoid stacking
          item.removeEventListener('mouseenter', onMouseEnter);
          item.removeEventListener('mouseleave', onMouseLeave);
          item.addEventListener('mouseenter', onMouseEnter);
          item.addEventListener('mouseleave', onMouseLeave);
        });
      }

      function onMouseEnter() {
        cursor.classList.add('cursor-hover');
        cursorDot.classList.add('cursor-dot-hover');
      }

      function onMouseLeave() {
        cursor.classList.remove('cursor-hover');
        cursorDot.classList.remove('cursor-dot-hover');
      }

      updateHoverables();
      // Watch DOM changes to bind new elements (for modals, menu filter etc.)
      const observer = new MutationObserver(updateHoverables);
      observer.observe(document.body, { childList: true, subtree: true });
    }

    function setupGlassSpotlights() {
      const glassCards = document.querySelectorAll('.glass-card-spotlight');
      glassCards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e as MouseEvent).clientX - rect.left;
          const y = (e as MouseEvent).clientY - rect.top;
          (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
          (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }

    function setupTiltCards() {
      const tiltCards = document.querySelectorAll('.tilt-card');
      tiltCards.forEach(card => {
        const inner = card.querySelector('.tilt-inner') as HTMLElement;
        if (!inner) return;
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e as MouseEvent).clientX - rect.left;
          const y = (e as MouseEvent).clientY - rect.top;
          
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          
          // Calculate rotation angles (-15deg to +15deg)
          const rotateX = ((y - centerY) / centerY) * -15;
          const rotateY = ((x - centerX) / centerX) * 15;
          
          inner.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });
        
        card.addEventListener('mouseleave', () => {
          inner.style.transform = 'rotateX(0deg) rotateY(0deg)';
          inner.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
        });
        
        card.addEventListener('mouseenter', () => {
          inner.style.transition = 'none';
        });
      });
    }

    function setupMagneticButtons() {
      const magnets = document.querySelectorAll('.btn-magnetic');
      magnets.forEach((magnetEl) => {
        const magnet = magnetEl as HTMLElement;
        magnet.addEventListener('mousemove', function(e) {
          const bound = magnet.getBoundingClientRect();
          const x = (e as MouseEvent).clientX - (bound.left + bound.width / 2);
          const y = (e as MouseEvent).clientY - (bound.top + bound.height / 2);
          magnet.style.transform = `translate(${x * 0.4}px, ${y * 0.4}px)`;
        });
        magnet.addEventListener('mouseleave', function() {
          magnet.style.transform = 'translate(0px, 0px)';
          magnet.style.transition = 'transform 0.4s cubic-bezier(0.25, 1, 0.5, 1)';
        });
        magnet.addEventListener('mouseenter', function() {
          magnet.style.transition = 'none';
        });
      });
    }

    function setupScrollProgress() {
      const progressBar = document.getElementById('scroll-progress-bar') as HTMLElement | null;
      if (!progressBar) return;

      function updateScrollProgress() {
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollHeight <= 0) return;
        const scrollPercent = (window.scrollY / scrollHeight) * 100;
        progressBar.style.width = `${scrollPercent}%`;
      }

      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      updateScrollProgress();
    }



    // Run on load and on page transition swap (Astro view transitions support)
    function initAll() {
      initMobileMenu();
      setupLiveStatusIndicator();
      setupCustomCursor();
      setupGlassSpotlights();
      setupTiltCards();
      setupMagneticButtons();
      setupScrollProgress();
    }

    document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('astro:after-swap', initAll);
  </script>
</body>
</html>
