          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
          document.body.classList.remove('overflow-hidden');

          setTimeout(() => {
            if (modal.classList.contains('opacity-0')) {
              modal.style.display = 'none';
            }
          }, 300);
        }

        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        // Event listener hooks for buttons on catering/tiffin pages
        document.body.addEventListener('click', (e) => {
          // Find if the clicked element is a trigger button
          const targetBtn = e.target.closest('button, a');
          if (!targetBtn) return;

          const text = targetBtn.textContent.replace(/\s+/g, ' ').trim().toLowerCase();
          
          if (isCateringPage) {
            if (text.includes('select basic') || text.includes('book standard') || text.includes('select premium')) {
              e.preventDefault();
              let pkg = "Catering: Standard Package";
              if (text.includes('basic')) pkg = "Catering: Basic Package";
              if (text.includes('premium')) pkg = "Catering: Premium Package";
              openModal(pkg);
            }
          } else if (isTiffinPage) {
            if (text.includes('start trial') || text.includes('subscribe now') || text.includes('contact sales') || text.includes('order now')) {
              e.preventDefault();
              let pkg = "Tiffin: Monthly Subscription";
              if (text.includes('trial') || text.includes('week')) pkg = "Tiffin: Weekly Trial";
              if (text.includes('sales') || text.includes('corporate')) pkg = "Tiffin: Corporate Plan";
              if (text.includes('order now')) pkg = "Tiffin: Plan Inquiry";
              openModal(pkg);
            }
          }
        });

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          
          const pkg = packageNameHidden.value;
          const diet = form.elements['diet-pref'].value;
          const date = document.getElementById('booking-date').value;
          const loc = document.getElementById('booking-location').value;
          
          let detailLine = "";
          if (isTiffinPage) {
            const dur = document.getElementById('tiffin-duration').value;
            detailLine = `Duration: ${dur}`;
          } else {
            const count = document.getElementById('guest-count').value;
            detailLine = `Estimated Guests: ${count}`;
          }

          const msg = `Hi Grill & Chill, I would like to make an inquiry:\n• Package: ${pkg}\n• Diet Preference: ${diet}\n• Date: ${date}\n• Location: ${loc}\n• ${detailLine}\n\nPlease confirm availability. Thanks!`;
          const phoneDigits = RESTAURANT.phone.replace(/\D/g, '');
          const waLink = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(msg)}`;
          
          window.open(waLink, '_blank', 'noopener,noreferrer');
          closeModal();
        });
      }

      setupBookingModal();
    });
  </script>
</body>
</html>
